# Template only - copy to config/Config.env and fill in real values.
# NEVER commit a filled-in copy. config/Config.env is gitignored; keep it that way.
# Every value below is a placeholder.

SQL_HOST=db.host.example
SQL_USER=sql_user
SQL_PASSWORD=CHANGE_ME
SQL_DB=MnCardio
NODE_ENV=production
JWT_PASS=CHANGE_ME_random_48_bytes_base64

# Port the API listens on (server.js). Defaults to 5001 when unset.
PORT=5001

# Gmail / Google Workspace requires a 16-character App Password here, NOT the
# account password. Generate one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled first). A normal password fails with
# '535 5.7.8 BadCredentials'.
MAIL_USER_NAME=mailbox@example.com
MAIL_USER_PASS=CHANGE_ME

# Optional: use a non-Gmail SMTP server instead. If MAIL_SMTP_HOST is set it
# overrides the Gmail defaults above.
# MAIL_SMTP_HOST=CHANGE_ME
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
ALLFILE_DIR1=/var/mncardio/
ALLFILE_DIR_WINDOWS=C:/MnCardio/
ALLFILE_DIR=/var/mncardio/
CLIENT_APP_URL=https://your.host.example/

# Where generated PDF/Excel reports are written. Read in 29 places, and the
# server EXITS on boot if it cannot create it (server.js:63-86). When unset it
# silently defaults to C:/MnCardioReports/ on Windows and
# /home/admin630/Desktop/outReports/ on Linux.
REPORT_DIR=/var/mncardio/

ALL_MODEL_DIR_WINDOWS=C:/MnCardio/
ALL_MODEL_DIR=/var/mncardio/
ALL_MODEL_DIR1=/var/mncardio/

EMD_USERNAME=CHANGE_ME
EMD_PASSWORD=CHANGE_ME

# ХУР (state data exchange). These three are the names the code actually reads
# - XypServiceController.js:16 reads XYP_KEY and XYP_TOKEN, and :24 reads
# REGNUM (this organisation's own registration number, sent with every call).
# XYP_ACCESS_TOKEN was in this template but is read nowhere; it is kept below,
# commented, only so an existing deployment that copied it can recognise it.
XYP_KEY=
XYP_TOKEN=
REGNUM=
# XYP_ACCESS_TOKEN=   CHANGE_ME

# NODE_TLS_REJECT_UNAUTHORIZED=0
# ^ DO NOT RE-ENABLE. Node reads this variable itself - no code in this repo
# references it - and setting it to 0 turns OFF certificate verification for
# EVERY outbound HTTPS call the server makes: XYP, EMD, SMTP, push. Anyone
# between this server and those services could then read or alter national
# health-data traffic. It shipped in this template, so every install seeded
# from it inherited the setting.
#
# If a service's certificate genuinely fails to verify, add that CA to the
# trust store (NODE_EXTRA_CA_CERTS) instead of disabling the check globally.

XYP_USERNAME=CHANGE_ME
XYP_PASSWORD=CHANGE_ME


SSL=false

# NOTE. Two keys that look required are NOT read by any code: SIGNATURE_HOST
# (digital signature is not implemented) and SQL_PORT (config/DbConnection.js
# passes only SQL_HOST). They are deliberately absent here - add them only when
# something actually consumes them.


# =============================================================================
# Behaviour flags - helper/FeatureFlags.js
#
# EVERY DEFAULT BELOW PRESERVES THE BEHAVIOUR THAT WAS THERE BEFORE THE FLAG
# EXISTED. Leave them all unset and the server behaves as it did. They are
# listed commented-out with their default so you can see what you are changing.
#
# The resolved values are printed at boot on one [FeatureFlags] line, so a
# deployment in the wrong mode is visible in the log rather than inferred.
#
# This is config/Config.env - the file server.js actually loads. The root .env
# files are near-dead and putting these there will not work.
# =============================================================================

# --- Authentication -----------------------------------------------------
# Skips JWT signature verification AND staff password validation. Requires
# NODE_ENV=CHANGE_ME
# a warning when it is on. Both bypasses used to key off NODE_ENV alone.
# ALLOW_INSECURE_DEV_AUTH=false

# Lockout after N failed passwords, and the tender's notify-after-3 (row 20).
# Works with no database change - the counter is in memory until
# add_login_attempt_tracking.sql is run, which adds persistence and a trail.
# FEATURE_LOGIN_LOCKOUT=false
# LOGIN_LOCKOUT_THRESHOLD=3
# LOGIN_LOCKOUT_WINDOW_MIN=15
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_LOCKOUT_NOTIFY=true

# --- Rate limiting ------------------------------------------------------
# Leave disabled for the first deploy: it then COUNTS and logs what it would
# have refused, without refusing anything. Read those lines, learn what a real
# hospital shift looks like, then enable. Guessing a limit and enforcing it on
# day one is how you block a ward.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MIN=5

# Body size. The limit is UNCHANGED at 100mb, because the registry forms post
# base64 images and the real ceiling is not guessable from the code. Requests
# above the warn threshold are logged so it can be set from data.
# JSON_BODY_LIMIT=CHANGE_ME
# BODY_SIZE_WARN_BYTES=CHANGE_ME

# --- Access audit (tracker row 24) --------------------------------------
# The WRITE side is on by default: it adds rows to a table that already exists
# and changes no response. Repeat reads of the same patient by the same user
# collapse for this many minutes.
# FEATURE_ACCESS_AUDIT=true
# ACCESS_AUDIT_DEDUPE_MIN=10

# The NOTIFY side is off until the customer says what "notify on every record
# access" means - the three readings differ in volume by orders of magnitude.
# none | every | digest | nontreating
# ACCESS_NOTIFY_POLICY=CHANGE_ME

# --- Push notifications (tracker row 48) --------------------------------
# UNSET IS A WORKING CONFIGURATION. With no keys the log driver runs: it writes
# "[PushHelper/log] WOULD SEND ..." and reports SUCCESS, so registration,
# fan-out and dead-token deactivation are all exercisable with nothing from
# ЗСҮТ. Reporting success is deliberate - see services/push/LogDriver.js - so
# that the code path which finally runs in production is the one already tested.
#
# log | fcm | apns | auto (default auto: driver chosen by which keys are present)
# Set log explicitly on any server that shares a Firebase project with
# production, or a test run rings real patients' phones.
# PUSH_DRIVER=CHANGE_ME

# Android, from the Firebase service-account JSON. FCM_PRIVATE_KEY must have its
# newlines escaped as \n - a PEM key cannot survive a .env file otherwise, and
# forgetting produces an opaque crypto error that never mentions newlines.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# iOS, from the .p8 key in the Apple Developer portal. APNS_PRODUCTION must
# match the build: a TestFlight build talks to production, an Xcode debug build
# talks to sandbox, and a token minted for one is rejected by the other with a
# BadDeviceToken that looks like a client bug.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=false

# --- Session revocation -------------------------------------------------
# Makes logout actually log out. Before this, revoking one session meant
# rotating JWT_PASS and signing out every user of the system, and LogOut was a
# stub - a lost phone could not be cut off.
#
# TWO-STEP ROLLOUT, AND THE ORDER MATTERS. Tokens issued before this feature
# existed carry no jti and live ten hours. Turning ALLOW_LEGACY off immediately
# would invalidate every one of them - logging out the entire system, which is
# precisely the outage the feature exists to prevent.
#
#   1. deploy with TOKEN_REVOCATION_ENABLED=true, ALLOW_LEGACY left true
#   2. wait 11 hours, so nothing without a jti can still be valid
#   3. set TOKEN_REVOCATION_ALLOW_LEGACY=false
#
# The denylist is in memory and refreshed on a timer, so a revoked token can
# survive up to REFRESH_SEC. That is the deliberate trade against a database
# read on every request; see helper/SessionStore.js.
# TOKEN_REVOCATION_ENABLED=false
# TOKEN_REVOCATION_REFRESH_SEC=30
# TOKEN_REVOCATION_ALLOW_LEGACY=true

# --- Patient access log (tracker 24, read side) -------------------------
# DO NOT ENABLE BEFORE scripts/add_access_audit.sql HAS RUN. UserActionHistory
# holds ~637,000 rows on test alone, and without IX_UserActionHistory_PatientId
# this query scans all of them on every app launch. The endpoint checks for the
# index too and refuses rather than taking the server down, but the flag is the
# first line of defence.
# FEATURE_ACCESS_LOG_API=false

# --- Doctor licence code (tracker 13) -----------------------------------
# READ THIS BEFORE CHANGING THE MODE. Measured on MnCardio_test 2026-09-14:
# 3,298 active doctors across 660 organizations, and EVERY ONE has no licence
# code, because the column did not exist until that day. Setting enforce now
# locks the entire national user base out of a clinical system.
#
# off | warn | enforce
#   off     (default) no query, behaviour unchanged
#   warn    allowed, but the login response carries LicenseWarning and an audit
#           row is written. RUN THIS FOR A FORTNIGHT - it answers "who is
#           actually affected" from real logins rather than a table scan, since
#           a doctor who has not signed in for a year is not a problem today.
#   enforce refuse. Do not set this until the count from
#           scripts/add_doctor_licence_code.sql has been agreed with ЗСҮТ.
# FEATURE_DOCTOR_LICENCE=CHANGE_ME
# Admins and settings accounts hold no clinical licence, and locking them out
# removes the very panel used to enter licences.
# LICENCE_EXEMPT_ROLES=CHANGE_ME
# LICENCE_EXEMPT_USER_IDS=
# ISO date; before it, enforce behaves as warn.
# LICENCE_GRACE_UNTIL=
# Whether a code has EXPIRED is a separate customer question from whether one exists.
# LICENCE_CHECK_EXPIRY=false

# --- Consent (tracker 23) -----------------------------------------------
# Governs the no-row and no-table cases only. Flipping to deny before any
# consent has been captured would silently disable every future secondary-use
# feature on day one; ЗСҮТ flip it at go-live, once patients have been asked.
# allow | deny
# CONSENT_DEFAULT=CHANGE_ME

# --- Confidentiality (tracker 21, 22) -----------------------------------
# off | warn | enforce.
#
# ENFORCE IS NOT IMPLEMENTABLE YET and the flag will not make it so. The
# access-rights matrix does not exist (BLOCKERS item 8), so five things are
# unknown - which levels exist, who may see which, whether hiding means the row
# is absent or masked, whether hidden rows still count in aggregates, and who
# may break glass. Each changes code, not configuration.
#
# 'warn' logs every row that WOULD have been hidden and hides nothing. That is
# how the impact assessment for the matrix conversation gets produced.
# FEATURE_CONFIDENTIALITY=CHANGE_ME

# --- File attachment ----------------------------------------------------
# MayAttachTo has a permissive default for any object it does not name. 'warn'
# logs which objects reach it and denies nothing; that log is how the allowlist
# gets written from evidence. Do not set 'enforce' before reading it - the
# models this endpoint serves are not enumerated anywhere in the code.
# off | warn | enforce
# FILE_ATTACH_STRICT=CHANGE_ME